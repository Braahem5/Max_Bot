# Токен бота, выданный MasterBot в MAX (см. README, раздел "Запуск").
# Реальный токен указывайте только в своём локальном .env (он в .gitignore).
# В репозиторий коммитить его нельзя (раздел "Ограничения", п.8).
MAX_BOT_TOKEN=

# Локальный SQLite-файл с планом пользователя (необязательно).
MAX_BOT_DB_PATH=/app/data/opora.sqlite3
