# Токен бота, выданный MasterBot в MAX (см. README, раздел "Запуск").
# Реальный токен указывайте только в своём локальном .env (он в .gitignore).
# В репозиторий коммитить его нельзя: токен даёт полный контроль над ботом.
MAX_BOT_TOKEN=
# Необязательно: 1 = перед стартом удалить старые подписки на вебхук
# (нужно, если этот токен раньше использовали с вебхуком).
# MAX_DELETE_WEBHOOK=1
